# ============================================================
# mondns — Variáveis de Ambiente
# Copie para .env e preencha com os valores reais.
# NUNCA commite o arquivo .env
# ============================================================

# ------------------------------------------------------------
# Aplicação
# ------------------------------------------------------------

# Porta em que a aplicação escuta (bind em 0.0.0.0)
PORT=8003

# Ambiente: development | staging | production
APP_ENV=development

# Chave secreta para JWT e criptografia geral (gerar com: openssl rand -hex 32)
SECRET_KEY=

# Número de workers Gunicorn (padrão: 2 * CPUs + 1)
WEB_CONCURRENCY=4

# Nível de log: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Versão da aplicação (usada na página Sobre)
APP_VERSION=0.2.0

# ------------------------------------------------------------
# Admin inicial (criado automaticamente na primeira execução)
# ------------------------------------------------------------
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=joao.andrade@sonda.com
INITIAL_ADMIN_PASSWORD=SENHA_FORTE_ADMIN_AQUI

# ------------------------------------------------------------
# Banco de Dados — PostgreSQL (porta dedicada 5433)
# Formato: postgresql://usuario:senha@host:porta/banco
# ------------------------------------------------------------
DATABASE_URL=postgresql://mondns_user:SENHA_FORTE_AQUI@localhost:5433/mondns_db

# Credenciais PostgreSQL (usadas pelo podman-compose)
POSTGRES_USER=mondns_user
POSTGRES_PASSWORD=SENHA_FORTE_AQUI
POSTGRES_DB=mondns_db
POSTGRES_PORT=5433

# Pool de conexões
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------
# Cache — Redis (porta dedicada 6380)
# Formato: redis://:senha@host:porta/db
# ------------------------------------------------------------
REDIS_URL=redis://:SENHA_REDIS_AQUI@localhost:6380/0

# Credenciais Redis (usadas pelo podman-compose)
REDIS_PASSWORD=SENHA_REDIS_AQUI
REDIS_PORT=6380

# ------------------------------------------------------------
# JWT (JSON Web Tokens)
# ------------------------------------------------------------

# Algoritmo JWT: RS256 (assimétrico, recomendado) ou HS256
JWT_ALGORITHM=RS256

# Expiração do access token em minutos (padrão: 15)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Expiração do refresh token em dias (padrão: 7)
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Chave privada RS256 (PEM, para assinar tokens) — path ou conteúdo
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private_key

# Chave pública RS256 (PEM, para verificar tokens)
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public_key

# ------------------------------------------------------------
# BIND 9 / DNS Integration
# ------------------------------------------------------------

# Caminho para o arquivo de log do named/BIND
BIND_LOG_PATH=/var/named/data/named_stats.txt

# Diretório de logs do named (para named.log ou query.log)
BIND_LOG_DIR=/var/log/named

# Arquivo de log de queries do BIND (named query log)
BIND_QUERY_LOG=/var/log/named/query.log

# Endereço IP do servidor DNS monitorado
DNS_SERVER_HOST=127.0.0.1

# Porta DNS (padrão: 53)
DNS_SERVER_PORT=53

# Threshold de queries por segundo para disparar alerta DDoS
DDOS_QUERY_THRESHOLD=1000

# Janela de tempo em segundos para análise de threshold
DDOS_WINDOW_SECONDS=60

# Intervalo de polling do log do BIND em segundos
BIND_POLL_INTERVAL_SECONDS=5

# ------------------------------------------------------------
# Notificações (opcional)
# ------------------------------------------------------------

# SMTP para alertas por e-mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=mondns@sondaativas.com.br
ALERT_EMAIL_TO=joao.andrade@sonda.com

# Webhook para notificações (Slack, Teams, etc.)
WEBHOOK_URL=

# ------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------

# Requisições máximas por minuto por IP (endpoints gerais)
RATE_LIMIT_PER_MINUTE=100

# Requisições máximas por minuto por IP (endpoints de auth)
RATE_LIMIT_AUTH_PER_MINUTE=10

# ------------------------------------------------------------
# Nginx / SSL (apenas referência — não usado diretamente pela app)
# ------------------------------------------------------------

# Subdomínio da aplicação
APP_SUBDOMAIN=mondns.sondaativas.com.br

# Caminho do certificado wildcard (gerenciado pelo Nginx compartilhado)
# SSL_CERT_PATH=/home/mondns/projetos/mondns/nginx/ssl/fullchain.pem
# SSL_KEY_PATH=/home/mondns/projetos/mondns/nginx/ssl/privkey.pem

# ------------------------------------------------------------
# OpenShift (para migração futura)
# ------------------------------------------------------------

# Namespace/projeto OpenShift
# OPENSHIFT_NAMESPACE=mondns

# Registry de imagens
# IMAGE_REGISTRY=registry.sondaativas.com.br/mondns
