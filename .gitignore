# ============================================================
# mondns — .gitignore
# ============================================================

# --- Secrets e variáveis de ambiente ---
.env
.env.*
!.env.example
*.env

# --- Certificados e chaves privadas ---
*.pem
*.key
*.crt
*.p12
*.pfx
*.cer
nginx/ssl/*
!nginx/ssl/.gitkeep

# --- Banco de dados local ---
*.db
*.sqlite
*.sqlite3

# --- Storage e uploads ---
storage/
uploads/
media/

# --- Logs ---
logs/
*.log
*.log.*

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Ambientes virtuais ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.virtualenv/

# --- Pytest e cobertura ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
nosetests.xml
test-results/

# --- MyPy e type checkers ---
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/

# --- IDEs e editores ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Jupyter Notebooks ---
.ipynb_checkpoints

# --- Node (se houver frontend) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity
dist/
.next/
.nuxt/

# --- Docker/Podman ---
.dockerignore

# --- Alembic ---
# (manter as migrations, ignorar apenas cache)

# --- Arquivos de sistema ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Arquivos temporários ---
*.tmp
*.temp
*.bak
*.orig

# --- Credenciais Git ---
.git-credentials
